# Copie para `.env.local` (ou defina no painel da hospedagem) antes do `npm run build`.
# Todas são opcionais. O valor vai embutido no HTML no momento do build:
# mudou uma variável, rode o build de novo.

# Endereço público final do site, com barra no fim. Vira o canonical, o og:url,
# o JSON-LD e o sitemap.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br/

# Subdiretório onde o site fica, sem barra no fim. Vazio = raiz do domínio.
# Ex.: /site  →  https://www.seudominio.com.br/site/
NEXT_PUBLIC_BASE_PATH=

# `true` quando este for o site oficial no ar: libera o Google para indexar,
# publica o sitemap no robots.txt e tira o aviso de "proposta" do rodapé.
# Sem isto o site se comporta como proposta (noindex).
NEXT_PUBLIC_SITE_OFICIAL=false

# Container do Google Tag Manager (GTM-XXXXXXX). Vazio = nenhuma tag carregada.
# GA4, Meta Pixel e Clarity entram configurados dentro do GTM.
NEXT_PUBLIC_GTM_ID=
